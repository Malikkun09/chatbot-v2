# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
# They must not appear in the client bundle, sessionStorage, or URLs.

# Required. NVIDIA NIM API key from https://build.nvidia.com
NVIDIA_API_KEY=

# Optional. Comma-separated extra keys used ONLY for reliability failover
# (401/403/429/5xx). Do not use this to stack quota.
NVIDIA_API_KEYS=

# Optional override. Default is the Nemotron 3 Nano Omni reasoning chat model.
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Optional. OpenAI-compatible NVIDIA NIM base (no trailing slash).
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
