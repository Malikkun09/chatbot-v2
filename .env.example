# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
# They must not appear in the client bundle, sessionStorage, or URLs.

# Required for the default OpenRouter :free picker models.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. Comma-separated extra OpenRouter keys used ONLY for reliability
# failover (401/403/429/5xx), max 3 attempts, random rotation.
# Do not use this to stack quota.
OPENROUTER_API_KEYS=

# Optional OpenRouter site headers (ranked listings). Defaults:
# OPENROUTER_SITE_URL=https://chatbot.malikfajar.me
# OPENROUTER_APP_NAME=Chatbot V2
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional. NVIDIA NIM key for non-:free / direct model ids
# (e.g. nvidia/nemotron-3-nano-omni-30b-a3b-reasoning without :free).
NVIDIA_API_KEY=

# Optional. Comma-separated extra NVIDIA keys for reliability failover only.
NVIDIA_API_KEYS=

# Optional NVIDIA model id when using the NIM path.
NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Optional. OpenAI-compatible NVIDIA NIM base (no trailing slash).
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
